rules_version = '2';

/* =============================================================================
   VIEENFAMILLE — RÈGLES DE SÉCURITÉ FIREBASE STORAGE (documents familiaux)

   Un fichier n'est lisible que par les membres de la famille à laquelle il
   appartient. L'appartenance est vérifiée en relisant le document Firestore
   de la famille : impossible de deviner une URL pour accéder aux documents
   d'une autre famille.
   ============================================================================= */

service firebase.storage {
  match /b/{bucket}/o {

    function estMembre(familleId) {
      return request.auth != null
        && request.auth.uid in
           firestore.get(/databases/(default)/documents/maisons/$(familleId)).data.membres;
    }

    function profil(familleId) {
      return firestore.get(/databases/(default)/documents/maisons/$(familleId)/profils/$(request.auth.uid)).data;
    }

    /** Un membre "restreint" ne voit les documents que si la case est cochée dans son profil. */
    function accesDocuments(familleId) {
      return estMembre(familleId) && (
        !firestore.exists(/databases/(default)/documents/maisons/$(familleId)/profils/$(request.auth.uid)) ||
        profil(familleId).role != 'restreint' ||
        (profil(familleId).permissions != null && profil(familleId).permissions.documents == true)
      );
    }

    match /familles/{familleId}/documents/{fichier} {
      allow read: if accesDocuments(familleId);

      allow write: if accesDocuments(familleId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches(
             'application/pdf|image/.*|text/.*|application/msword'
             + '|application/vnd.*|application/octet-stream'
           );

      allow delete: if accesDocuments(familleId);
    }

    /* ---- Photos de profil : chacun ne gère que la sienne. Pour un enfant, {uid}
       est l'id de son document enfants/{id} (jamais son uid anonyme, qui change
       d'une session à l'autre) — vérifié via le même claim uidActuel que Firestore. ---- */
    function estEnfantVerifie(familleId) {
      return request.auth != null && firestore.exists(
        /databases/(default)/documents/maisons/$(familleId)/enfantsVerifies/$(request.auth.uid));
    }

    function estCetEnfant(familleId, enfantId) {
      return estEnfantVerifie(familleId) && firestore.get(
        /databases/(default)/documents/maisons/$(familleId)/enfants/$(enfantId)).data.uidActuel == request.auth.uid;
    }

    match /familles/{familleId}/avatars/{uid} {
      allow read: if estMembre(familleId) || estEnfantVerifie(familleId);
      allow write: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && ((request.auth != null && request.auth.uid == uid && estMembre(familleId))
            || estCetEnfant(familleId, uid));
      allow delete: if (request.auth != null && request.auth.uid == uid && estMembre(familleId))
        || estCetEnfant(familleId, uid);
    }

    // Aucun autre chemin n'est accessible.
    match /{chemin=**} {
      allow read, write: if false;
    }
  }
}
